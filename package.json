    "e2e:dev": "start-server-and-test dev http-get://0.0.0.0:5173 e2e",
    "e2e:open": "cypress open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
